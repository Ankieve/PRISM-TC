# Copy this file to .env and edit as needed. Never commit the real .env
# (it is already listed in .gitignore). Leaving everything as-is below
# gives you the free, no-account IMD/INSAT-3D source with sensible defaults.

# --- General server ---
HOST=127.0.0.1
PORT=8000

# --- Satellite feature on/off ---
SATELLITE_ENABLED=true

# Primary source. "imd_insat" (India's own INSAT-3D/3DS via IMD's public
# site) is the default and fully implemented - free, no account, and its
# single frame covers the WHOLE North Indian Ocean (Arabian Sea + Bay of
# Bengal) at once. "himawari_nict" is kept in the codebase but UNVERIFIED -
# its exact current tile URL scheme could not be confirmed live during this
# build (see backend/satellite/README.md "Why IMD/INSAT instead of
# Himawari"). "eumetsat_iodc" is scaffolded but needs credentials below AND
# has not been exercised against the live API. "mosdac" is a documented
# stub, not implemented - see sources/mosdac.py.
SATELLITE_SOURCE=imd_insat

# Optional fallback, tried only if the primary source fails outright.
# Leave blank to disable. Not set to himawari_nict by default since that
# source is unverified (see above) - would fail anyway, wasting a retry.
SATELLITE_FALLBACK_SOURCE=

# How often to check for a new observation (seconds). INSAT-3D/3DS's normal
# scan cadence is roughly every 30 minutes; do not set this below ~120s, it
# would just re-fetch the same unchanged file for no benefit.
UPDATE_INTERVAL=300

# How old an observation can be before the frontend shows STALE instead of
# LIVE (seconds). 40 minutes covers the ~30-minute cadence plus publication
# latency plus polling slack.
SATELLITE_STALE_AFTER_SECONDS=2400

# The exact URL IMD publishes the Asia-sector Thermal IR-1 quicklook at.
# Change this only if IMD moves/renames the file - see sources/imd_insat.py.
IMD_INSAT_IR1_URL=https://mausam.imd.gov.in/Satellite/3Dasiasec_ir1.jpg

# North Indian Ocean bounding box (degrees). Only used by sources that
# support a programmatic crop (currently just the unverified Himawari
# source - see region_crop_supported in sources/base.py). The default
# imd_insat source ignores this: it serves IMD's own pre-framed Asia-sector
# image as-is rather than guessing a crop, and reports that honestly via
# the "region" field's "description" in GET /api/satellite/status.
SATELLITE_LAT_MIN=-5
SATELLITE_LAT_MAX=30
SATELLITE_LON_MIN=40
SATELLITE_LON_MAX=100

# Whether to run the existing model (predict.py) on the live image.
# OFF by default - see backend/satellite/inference_bridge.py for exactly
# why this is not scientifically validated yet. Only turn this on once you
# understand and accept that.
ENABLE_LIVE_INFERENCE=false

# --- EUMETSAT IODC (optional fallback; needs a free account) ---
# Register at https://eoportal.eumetsat.int/ (free, no card) and create API
# credentials at https://api.eumetsat.int/api-key/ to get these two values.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
# Confirm the exact collection id for "Meteosat-8 (IODC) Level 1.5 image
# data" on https://data.eumetsat.int yourself - we deliberately do not
# guess one here.
EUMETSAT_COLLECTION_ID=

# --- MOSDAC (not implemented - see backend/satellite/sources/mosdac.py) ---
# These are read by config.py so they are ready to use once someone
# implements MosdacSource, but nothing uses them yet.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# --- ERA5 reanalysis fetch (optional - see backend/era5.py) ---
# Needs `pip install -r backend/requirements-era5.txt` AND a free Copernicus
# CDS account with your API key in ~/.cdsapirc - NEVER put the key here or
# in any file in this repo. Leave ERA5_ENABLED=true; the feature quietly
# reports itself unavailable (GET /api/era5/status) until both the packages
# and the credentials are actually in place, and never affects /api/predict.
ERA5_ENABLED=true
# Live CDS requests are OFF by default: the demo serves only repo-bundled
# seed files + on-disk cache, so it can never hang on a Copernicus queue.
# Set ERA5_LIVE=true (plus CDSAPI_URL/CDSAPI_KEY) only on a machine where a
# minutes-long queued job is acceptable - the endpoint returns a job id
# immediately and the frontend polls it.
ERA5_LIVE=false
# ERA5's near-real-time extension (ERA5T) is typically published with a few
# days' lag. This app requests data from this many days ago by default so a
# fetch doesn't fail just because "now" isn't published yet - see era5.py.
ERA5_LAG_DAYS=5
# Soft client-side cutoff (seconds) before /api/era5/fetch gives up waiting
# on a slow CDS queue and returns a "try again shortly" error instead of
# hanging the request. The underlying CDS job is not cancelled by this.
ERA5_REQUEST_TIMEOUT_SECONDS=90
